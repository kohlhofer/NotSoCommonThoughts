---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostListItem from '../../components/PostListItem.astro';
import BlogHero from '../../components/BlogHero.astro';
import AuthorBio from '../../components/AuthorBio.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Share image, mirroring how PostListItem derives a thumbnail: the frontmatter
// image, else the first inline image in the body, else the branded default the
// Layout falls back to. Generative-thumbnail posts have no static image, so
// they use the default too.
const firstInlineImage = post.body.match(/!\[.*?\]\((.*?)\)/)?.[1];
const ogImage = post.data.useGenerativeThumbnail
  ? undefined
  : post.data.image ?? firstInlineImage;

// Article structured data: the typed twin of the og:type=article tags, for
// crawlers and AI answers that read JSON-LD instead of meta.
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  ...(post.data.description ? { description: post.data.description } : {}),
  image: new URL(ogImage ?? '/images/og-default.webp', Astro.site).href,
  datePublished: post.data.date.toISOString().slice(0, 10),
  dateModified: post.data.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Alexander Kohlhofer', url: 'https://kohlhofer.com' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, Astro.site).href },
};

// Get all categories from tags
const categories = post.data.tags || [];

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p =>
    p.slug !== post.slug &&
    !p.data.unlisted &&
    (p.data.tags || []).some(tag => categories.includes(tag))
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Layout title={`${post.data.title} - NSCT`} description={post.data.description} image={ogImage} ogType="article" noindex={post.data.unlisted} jsonLd={article}>
  <!-- Post header -->
  <BlogHero post={post} />

  <!-- Article -->
  <article class="max-w-2xl mx-auto mt-12 sm:mt-14 prose prose-lg">
    <Content />
  </article>

  <!-- Author bio -->
  <div class="max-w-2xl mx-auto mt-14 pt-8 border-t border-line">
    <AuthorBio />
  </div>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="max-w-2xl mx-auto mt-12 pt-10 border-t border-line pb-8">
      <p class="eyebrow mb-8">More posts</p>
      <div class="space-y-10">
        {relatedPosts.map(rp => <PostListItem post={rp} />)}
      </div>
    </section>
  )}
</Layout>
