---
import type { CollectionEntry } from 'astro:content';
import { formatDate, categoryUrl } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date } = post.data;

const tags = post.data.tags || [];
const readMinutes = Math.max(1, Math.round(post.body.split(' ').length / 200));
---

<!-- Page-header band: cancels the layout's padding and runs up behind the wordmark, like the home hero -->
<div class="-mx-4 sm:-mx-8 -mt-20 sm:-mt-24 px-4 sm:px-8 bg-surface">
  <header class="max-w-2xl mx-auto pt-28 sm:pt-36 pb-12 sm:pb-14">
    <!-- Back link -->
    <a href="/" class="inline-flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent hover:text-accent-strong transition-colors">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H6M12 5l-7 7 7 7"/></svg>
      All thoughts
    </a>

    <!-- Title -->
    <h1 class="mt-4 text-[1.875rem] sm:text-[2.5rem] lg:text-[3.25rem] font-semibold tracking-[-0.03em] leading-[1.05] text-balance text-ink">
      {title}
    </h1>

    <!-- Description -->
    {description && (
      <p class="mt-5 max-w-xl text-xl tracking-[-0.01em] leading-normal text-pretty text-muted">
        {description}
      </p>
    )}

    <!-- Meta: date and reading time, then categories -->
    <div class="eyebrow mt-9 flex flex-wrap justify-between gap-x-6 gap-y-2">
      <p>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="px-2 text-line-strong" aria-hidden="true">·</span>
        <span>{readMinutes} min read</span>
      </p>

      {tags.length > 0 && (
        <p>
          {tags.map((tag, i) => {
            const tagName = tag
              .split('-')
              .map(word => word.charAt(0).toUpperCase() + word.slice(1))
              .join(' ');
            return (
              <>
                {i > 0 && <span class="px-2 text-line-strong" aria-hidden="true">·</span>}
                <a href={categoryUrl(tag)} class="hover:text-accent transition-colors">{tagName}</a>
              </>
            );
          })}
        </p>
      )}
    </div>
  </header>
</div>
